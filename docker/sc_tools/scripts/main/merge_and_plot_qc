#!/usr/bin/env python3

import argparse
import scanpy as sc
from anndata import concat as ad_concat
from anndata import AnnData
import pandas as pd
import sys


def merge_adata(adata_objects_fofn: str, chunk_size: int = 50) -> AnnData:
    sample_files = []
    # Note that the sample id should be the official ASAP_samples
    with open(adata_objects_fofn, "r") as file:
        for sample in file:
            # Check that sample line is not empty
            if sample.strip():
                columns = sample.strip().split("\t")
                sample_files.append(columns)

    print(f"Processing {len(sample_files)} samples in chunks of {chunk_size}")

    merged_chunks = []

    for i in range(0, len(sample_files), chunk_size):
        chunk_files = sample_files[i:i+chunk_size]
        print(f"Processing chunk {i//chunk_size + 1}/{(len(sample_files)-1)//chunk_size + 1}")

        adatas = {}
        for sample_name, file_path in chunk_files:
            raw = sc.read_h5ad(file_path)
            adatas[sample_name] = raw

        chunk_adata = ad_concat(
            adatas, 
            merge="same", 
            uns_merge="same", 
            index_unique="_"
        )

        merged_chunks.append(chunk_adata)

        # Clean up memory
        del adatas

    print("Merging all chunks...")
    final_adata = ad_concat(merged_chunks, merge="same", uns_merge="same", index_unique="_")

    return final_adata


def downsample_adata(adata: AnnData, n_cells: int) -> AnnData:
    print(f"Downsampling adata to {n_cells} cells...")
    ds_adata = sc.pp.sample(adata, n=n_cells, rng=42, copy=True)

    return ds_adata


def gen_qc_plots(adata: AnnData, plots_dir: str):
    print("Generating QC plots...")

    # Fixed parameters
    metrics = [
        "n_genes_by_counts",
        "total_counts",
        "pct_counts_mt",
        "pct_counts_rb",
        "doublet_score",
    ]

    # Set CPUs to use for parallel computing
    sc.settings.n_jobs = -1

    sc.settings.verbosity = 1
    sc.settings.figdir = f"{plots_dir}/"
    sc.set_figure_params(
        dpi=100, fontsize=10, dpi_save=300, format="png", figsize=(12, 8)
    )  # type: ignore

    for metric in metrics:  # type: ignore
        sc.pl.violin(adata, keys=metric, size=0, save="".join("_" + metric))


def main(args: argparse.Namespace):
    adata = merge_adata(args.adata_objects_fofn)
    gen_qc_plots(adata, "plots")

    # Export concatenated data
    adata.write_h5ad(filename=args.adata_output, compression="lzf")
    print(f"Wrote {args.adata_output}")
    # Save metadata
    adata.obs.to_csv(args.output_metadata_file, index=True)
    print(f"Wrote {args.output_metadata_file}")

    # Downsampling is optional; by default all cells are kept
    if args.n_cells is None:
        print("No --n-cells provided; keeping all cells")
        return
    if args.ds_adata_output is None or args.ds_output_metadata_file is None:
        raise ValueError("[ERROR] --ds-adata-output and --ds-output-metadata-file are required with --n-cells")
    if args.n_cells >= adata.n_obs:
        print(f"--n-cells {args.n_cells} >= {adata.n_obs} cells; keeping all cells in the downsampled outputs")
        ds_adata = adata
    else:
        ds_adata = downsample_adata(adata, args.n_cells)
    gen_qc_plots(ds_adata, "ds_plots")

    # Export downsampled concatenated data
    ds_adata.write_h5ad(filename=args.ds_adata_output, compression="lzf")
    print(f"Wrote {args.ds_adata_output}")
    # Save downsampled metadata
    ds_adata.obs.to_csv(args.ds_output_metadata_file, index=True)
    print(f"Wrote {args.ds_output_metadata_file}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Merge AnnData objects, optionally downsample, and plot QC metrics")
    parser.add_argument(
        "--adata-objects-fofn",
        type=str,
        required=True,
        help="Newline-delimited TSV of sample names and paths to the set of input adata objects (file-of-filenames)",
    )
    parser.add_argument(
        "--n-cells",
        type=int,
        required=False,
        default=None,
        help="Number of cells to keep. Cells are drawn uniformly at random without replacement for downsampling. Default is to keep all cells",
    )
    parser.add_argument(
        "--adata-output",
        type=str,
        required=True,
        help="Output file to save fully merged AnnData object to",
    )
    parser.add_argument(
        "--output-metadata-file",
        required=True,
        type=str,
        help="Output file to write fully merged AnnData metadata to",
    )
    parser.add_argument(
        "--ds-adata-output",
        type=str,
        required=False,
        help="Output file to save downsampled AnnData object to; required with --n-cells",
    )
    parser.add_argument(
        "--ds-output-metadata-file",
        required=False,
        type=str,
        help="Output file to write downsampled AnnData metadata to; required with --n-cells",
    )

    args = parser.parse_args()
    main(args)
