    )
    parser.add_argument(
        "--doublet-score-max",
        type=float,
        required=True,
        help="Maximum doublet detection score threshold [0.2]"
    )
    parser.add_argument(
        "--total-counts-limits",
        type=int,
        nargs="+",
        required=True,
        help="Absolute minimum and maximum total UMI (unique molecular identifier) counts per cell [500, 150000]"
    )
    parser.add_argument(
        "--n-genes-by-counts-limits",
        type=int,
        nargs="+",
        required=True,
        help="Absolute minimum and maximum number of genes detected per cell (genes with at least one count) [300, 15000]"
    )
    parser.add_argument(
        "--n-mads-lower",
        type=float,
        default=3,
        help="Number of median absolute deviations below the median allowed for total_counts and n_genes_by_counts [3]"
    )
    parser.add_argument(
        "--n-mads-upper",
        type=float,
        default=5,
        help="Number of median absolute deviations above the median allowed for total_counts and n_genes_by_counts [5]"
    )
    parser.add_argument(
        "--mad-group-key",
        type=str,
        default="sample",
        help="Key in obs to compute MAD thresholds within; 'none' computes them cohort-wide [sample]"
    )
    parser.add_argument(
        "--adata-output",
        type=str,
        required=True,
        help="Output file to save AnnData object to",
    )
    parser.add_argument(
        "--output-removed-cells-file",
        type=str,
        required=True,
        help="Output CSV listing every removed cell (barcode), its sample metadata and QC metrics, and which filters it failed",
    )

    args = parser.parse_args()
    if args.mad_group_key.lower() == "none":
        args.mad_group_key = None
    main(args)
